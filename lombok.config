# Configuración de Lombok del proyecto (ver docs/adr/0003-lombok-immutables.md)
config.stopBubbling = true

# Accesores al estilo record: id() en lugar de getId()
lombok.accessors.fluent = true

# Marca el código generado para que las herramientas de cobertura y análisis lo ignoren
lombok.addLombokGeneratedAnnotation = true

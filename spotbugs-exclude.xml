<?xml version="1.0" encoding="UTF-8"?>
<!-- Exclusiones de SpotBugs (ADR 0020): acotadas por patrón y por clase, nunca un paquete entero, y cada una con su porqué -->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">

    <!-- Código que genera Immutables (lleva @org.immutables.value.Generated en el bytecode): no se puede corregir, se
         regenera en cada compilación.
         - AT_STALE_THREAD_WRITE_OF_PRIMITIVE: los campos *BuildStage de su InitShim los usa un solo hilo y solo
           mientras se construye un objeto.
         - EI_EXPOSE_REP: sus listas ya son copias no modificables (createUnmodifiableList en el constructor). -->
    <Match>
        <Annotation name="org.immutables.value.Generated"/>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE,EI_EXPOSE_REP"/>
    </Match>

    <!-- Entidades JPA de los adaptadores de salida: Hibernate lee sus campos por reflexión (p. ej.
         TransactionEntity.position, que ordena los movimientos con @OrderBy y tiene una restricción única). -->
    <Match>
        <Class name="~com\.dawnrock\.ddd\.adapter\.out\..*Entity"/>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>

    <!-- Find Security Bugs (#205, ADR 0020). Falsos positivos revisados uno a uno. -->

    <!-- La cadena de la API no tiene sesión y solo acepta tokens Bearer (ADR 0015): no hay cookie que una petición de
         otro sitio pueda aprovechar, así que la protección CSRF no aporta nada. La cadena web la mantiene activa. -->
    <Match>
        <Class name="com.dawnrock.ddd.adapter.in.rest.ApiSecurityConfig"/>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    </Match>

    <!-- La página 403: Spring Security reenvía aquí la petición denegada conservando su método, por eso acepta cualquiera.
         Solo pinta la página de error; no cambia ningún estado. -->
    <Match>
        <Class name="com.dawnrock.ddd.adapter.in.web.AccessDeniedController"/>
        <Method name="forbidden"/>
        <Bug pattern="SPRING_CSRF_UNRESTRICTED_REQUEST_MAPPING"/>
    </Match>

    <!-- Tras volver de Auth0 redirige a /login/link o /login?oauth-error: el context path de la propia aplicación y una
         ruta fija. Ningún dato de la petición elige el destino. -->
    <Match>
        <Class name="com.dawnrock.ddd.adapter.in.web.OAuth2LoginFailureHandler"/>
        <Method name="onAuthenticationFailure"/>
        <Bug pattern="UNVALIDATED_REDIRECT"/>
    </Match>
</FindBugsFilter>
